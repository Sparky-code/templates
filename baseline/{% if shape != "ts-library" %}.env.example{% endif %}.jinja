# Copy to .env and fill in. Never commit .env.
{%- if shape == 'ts-cli' %}
DATABASE_URL=file:./data/{{ project_name }}.db
{%- elif shape == 'python-cli' %}
{{ package_name | upper }}_DB=data/{{ project_name }}.db
{%- elif shape == 'python-service' %}
{{ package_name | upper }}_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/{{ package_name }}
POSTGRES_PASSWORD=app
# Host port for the local Postgres (compose.yaml)
POSTGRES_PORT=5432
{%- elif shape == 'react-web' and with_api %}
PORT=3000
{%- endif %}
{%- if is_job and shape in ['ts-cli', 'python-cli'] %}

# Push notification when a run fails (ntfy topic URL); leave empty to disable
NTFY_URL=
{%- endif %}
{%- if uses_claude %}

# Claude CLI binary (default: claude on PATH) and model
CLAUDE_BIN=
CLAUDE_MODEL=sonnet
{%- endif %}
