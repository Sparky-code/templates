[project]
name = "{{ project_name }}"
version = "0.1.0"
description = {{ description | tojson }}
readme = "README.md"
requires-python = ">=3.14"
{%- if license == 'MIT' %}
license = "MIT"
{%- endif %}
dependencies = [
    "httpx>=0.28.1",
    "typer>=0.29.2",
]

[project.scripts]
{{ project_name }} = "{{ package_name }}.cli:app"

[dependency-groups]
dev = [
    "mypy>=2.4.1",
    "pytest>=9.2.0",
    "ruff>=0.17.6",
]

[build-system]
requires = ["uv_build>=0.13.9,<0.14"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ package_name }}"

[tool.ruff]
line-length = 100
target-version = "py314"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "SIM", "RUF"]

[tool.mypy]
strict = true
files = ["src", "tests"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-m 'not live'"
markers = ["live: talks to real external services; run with `pytest -m live`"]
