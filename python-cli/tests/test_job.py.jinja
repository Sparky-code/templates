from __future__ import annotations

import os
import sqlite3
from pathlib import Path

import httpx
import pytest

from {{ package_name }} import db
from {{ package_name }}.job import JobContext, LockedError, ntfy_notifier, run_job, run_lock


@pytest.fixture
def conn(tmp_path: Path) -> sqlite3.Connection:
    return db.connect(tmp_path / "app.db")


def test_lock_refuses_a_live_holder_and_takes_over_a_stale_one(tmp_path: Path) -> None:
    lock = tmp_path / "run.lock"
    with run_lock(lock):
        assert lock.read_text() == str(os.getpid())
        with pytest.raises(LockedError), run_lock(lock):
            pass
    assert not lock.exists()
    lock.write_text("999999999")  # no such process
    with run_lock(lock):
        pass


def test_records_a_successful_run(conn: sqlite3.Connection, tmp_path: Path) -> None:
    def work(ctx: JobContext) -> str:
        return f"handled {ctx.max_items}"

    ok = run_job(
        "demo",
        work,
        conn=conn,
        lock_path=tmp_path / "l",
        dry_run=True,
        max_items=3,
        log=lambda _: None,
    )
    assert ok
    row = conn.execute("SELECT job, ok, dry_run, detail FROM runs").fetchone()
    assert tuple(row) == ("demo", 1, 1, "handled 3")


def test_records_a_failure_and_notifies(conn: sqlite3.Connection, tmp_path: Path) -> None:
    sent: list[str] = []

    def work(ctx: JobContext) -> str:
        raise RuntimeError("upstream down")

    ok = run_job(
        "demo",
        work,
        conn=conn,
        lock_path=tmp_path / "l",
        dry_run=False,
        max_items=1,
        notify=sent.append,
        log=lambda _: None,
    )
    assert not ok
    assert sent == ["demo failed: upstream down"]
    assert tuple(conn.execute("SELECT ok, detail FROM runs").fetchone()) == (0, "upstream down")


def test_ntfy_notifier_is_off_without_a_url_and_posts_with_one() -> None:
    assert ntfy_notifier("") is None
    seen: list[httpx.Request] = []

    def handler(request: httpx.Request) -> httpx.Response:
        seen.append(request)
        return httpx.Response(200)

    client = httpx.Client(transport=httpx.MockTransport(handler))
    notify = ntfy_notifier("https://ntfy.example/topic", client)
    assert notify is not None
    notify("boom")
    assert seen[0].content == b"boom"
