# Local Postgres for development. Pinned image, named volume, healthcheck,
# bound to localhost only. Password comes from .env (POSTGRES_PASSWORD).
services:
  db:
    image: postgres:18.7-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
      POSTGRES_DB: {{ package_name }}
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    volumes:
      - pgdata:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d {{ package_name }}"]
      interval: 5s
      timeout: 3s
      retries: 10

volumes:
  pgdata:
