"""Settings from the environment.

Variables are prefixed {{ package_name | upper }}_; locally they come from .env via
`uv run --env-file .env`.
"""

from __future__ import annotations

from functools import lru_cache

from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    model_config = SettingsConfigDict(env_prefix="{{ package_name | upper }}_")

    database_url: str = "postgresql+asyncpg://app:app@localhost:5432/{{ package_name }}"
    debug: bool = False


@lru_cache
def get_settings() -> Settings:
    return Settings()
