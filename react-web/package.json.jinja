{
  "name": "{{ project_name }}",
  "version": "0.1.0",
  "private": true,
  "description": {{ description | tojson }},
  "license": "{{ license }}",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
{%- if with_api %}
    "start": "node --env-file-if-exists=.env src/server/index.ts",
{%- endif %}
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
{%- if with_api %}
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
{%- endif %}
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
{%- if with_api %}
    "hono": "^4.13.21",
{%- endif %}
    "lucide-react": "^1.78.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"{{ ',' if with_api }}
{%- if with_api %}
    "zod": "^4.6.7"
{%- endif %}
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
{%- if with_api %}
    "@hono/vite-dev-server": "^0.26.1",
{%- endif %}
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
