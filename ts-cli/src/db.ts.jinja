import { mkdirSync } from 'node:fs';
import { dirname } from 'node:path';
import { PrismaLibSql } from '@prisma/adapter-libsql';
import { PrismaClient } from './generated/prisma/client.ts';

export const DEFAULT_DATABASE_URL = 'file:./data/{{ project_name }}.db';

/** Opens the database (SQLite file locally, or Turso/libsql when the URL says so). */
export function openDb(url = process.env.DATABASE_URL ?? DEFAULT_DATABASE_URL): PrismaClient {
  if (url.startsWith('file:')) mkdirSync(dirname(url.slice('file:'.length)), { recursive: true });
  return new PrismaClient({ adapter: new PrismaLibSql({ url }) });
}

export type Db = PrismaClient;
