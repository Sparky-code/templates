// Copy the built package into an app as a committed, vendored copy:
//
//   pnpm run vendor -- ../my-app/vendor/{{ project_name }}
//
// Builds first, then writes the compiled files, package.json, LICENSE (if any)
// and a VENDORED.md recording the version and commit. The destination must be
// empty, missing, or a previous vendored copy of this package; anything else is
// refused so nothing unrelated is overwritten.
import { execFileSync } from 'node:child_process';
import {
  cpSync,
  existsSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  rmSync,
  writeFileSync,
} from 'node:fs';
import { basename, dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

interface PackageJson {
  name: string;
  version: string;
  description?: string;
  type?: string;
  license?: string;
  sideEffects?: boolean;
  exports: Record<string, string | Record<string, string>>;
}

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const pkg = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8')) as PackageJson;
const arg = process.argv.slice(2).find((a) => a !== '--');
if (!arg) {
  console.error('usage: pnpm run vendor -- <destination directory>');
  process.exit(1);
}
const dest = resolve(arg);
if (basename(dest) !== pkg.name) {
  console.error(`refusing: destination folder must be named "${pkg.name}" (got ${basename(dest)})`);
  process.exit(1);
}
if (existsSync(dest) && readdirSync(dest).length) {
  const existing = join(dest, 'package.json');
  const name = existsSync(existing)
    ? (JSON.parse(readFileSync(existing, 'utf8')) as PackageJson).name
    : null;
  if (name !== pkg.name) {
    console.error(`refusing: ${dest} is not empty and is not a vendored copy of ${pkg.name}`);
    process.exit(1);
  }
  rmSync(dest, { recursive: true });
}

execFileSync('pnpm', ['run', 'build'], { cwd: root, stdio: 'inherit' });

mkdirSync(dest, { recursive: true });
cpSync(join(root, 'dist'), dest, { recursive: true });
if (existsSync(join(root, 'LICENSE'))) cpSync(join(root, 'LICENSE'), join(dest, 'LICENSE'));

// In the vendored copy the files sit at the top level, not under dist/.
const strip = (path: string) => path.replace('./dist/', './');
const exportsMap = Object.fromEntries(
  Object.entries(pkg.exports).map(([key, value]) => [
    key,
    typeof value === 'string'
      ? strip(value)
      : Object.fromEntries(Object.entries(value).map(([k, v]) => [k, strip(v)])),
  ]),
);
const { name, version, description, type, license, sideEffects } = pkg;
const vendored = { name, version, description, type, license, sideEffects, exports: exportsMap };
writeFileSync(join(dest, 'package.json'), `${JSON.stringify(vendored, null, 2)}\n`);

const git = (...args: string[]): string | null => {
  try {
    return execFileSync('git', args, { cwd: root, encoding: 'utf8' }).trim();
  } catch {
    return null;
  }
};
const commit = git('rev-parse', '--short', 'HEAD') ?? 'unknown';
const tag = git('describe', '--tags', '--exact-match');
const dirty = git('status', '--porcelain') ? ' (with uncommitted changes)' : '';
writeFileSync(
  join(dest, 'VENDORED.md'),
  `# ${name} ${version} (vendored)

Generated by \`pnpm run vendor\` in the ${name} repo. Do not edit these files by
hand: change ${name}, release a new version, and vendor again.

- Version: ${version}${tag ? ` (tag ${tag})` : ''}
- Commit: ${commit}${dirty}
`,
);
console.log(`vendored ${name} ${version} (${tag ?? commit}${dirty}) → ${dest}`);
